{
  "name": "clarity-dialer-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for the Clarity Claude Sales Copilot: Twilio tokens, call tickets and TwiML.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@twilio/voice-sdk": "^2.18.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
