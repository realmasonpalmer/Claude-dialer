# Copy to .env for local runs. On the host, set these as secrets.
PORT=8080
# Public https URL of this server. Twilio signs webhooks against it.
PUBLIC_BASE_URL=https://your-dialer.example.com

# Shared key Salesforce sends in the X-Clarity-Key header (set the same value
# in Salesforce Setup > External Credentials > Clarity Dialer > ApiKey).
CLARITY_API_KEY=change-me-long-random-string
# Signs one-time call tickets. Any long random string.
TICKET_SECRET=change-me-another-long-random-string

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Your Twilio number in E.164, shown as caller ID.
TWILIO_CALLER_ID=+15555550100
